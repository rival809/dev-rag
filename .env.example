# Gemini API — ambil dari https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (embedding saja, tidak perlu LLM besar)
EMBED_MODEL=nomic-embed-text

# RAG config
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Domain (isi jika punya domain untuk HTTPS)
DOMAIN=
