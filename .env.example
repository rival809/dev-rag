# Gemini API — ambil dari https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Gemma 4: Unlimited TPM, 1.5K RPD — primary
# Gemini Flash: fallback jika Gemma gagal
GEMINI_MODELS=gemma-4-31b-it,gemma-4-27b-it,gemini-2.5-flash,gemini-2.0-flash

# Ollama (embedding saja, tidak perlu LLM besar)
EMBED_MODEL=nomic-embed-text

# RAG config
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Domain (isi jika punya domain untuk HTTPS)
DOMAIN=
